{
  "name": "peak-translation",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/core && npm run build --workspace=packages/providers && npm run build --workspace=apps/web",
    "dev:extension": "npm run dev --workspace=apps/extension",
    "dev:web": "npm run dev --workspace=apps/web",
    "lint": "eslint .",
    "test": "jest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.0.0",
    "vite": "^8.3.0"
  }
}
